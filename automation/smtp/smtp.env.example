# Generic SMTP environment template (no secrets)
# Copy to: ~/.config/automation/smtp.env

export HBOT_SMTP_HOST="smtp.example.com"
export HBOT_SMTP_PORT="587"
export HBOT_SMTP_USER="your_smtp_username"
export HBOT_SMTP_PASSWORD="your_smtp_password"
export HBOT_SMTP_FROM="automation@example.com"
export HBOT_SMTP_STARTTLS="true"
